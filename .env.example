# BonsaiWire is offline-only; it needs no secrets and no network.
# The passphrase unlocks the write commands (tree add / schedule add /
# schedule remove / log add).  When it is unset the tool prompts with a
# no-echo getpass prompt, so this file is optional for interactive use.
#
# The seeded demo store is created with this passphrase (owner: cenius).
BONSAIWIRE_PASSPHRASE=cenius
